{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes http-server@14.1.1 frontend/out -p 4173 -c-1",
      "startServerReadyPattern": "Available on:",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/advisor/",
        "http://localhost:4173/optimizer/",
        "http://localhost:4173/screener/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
