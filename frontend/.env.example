# Dev only (next dev on :3000 with the backend on :8000).
# In prod, leave this unset: the frontend is served by the backend, /api calls are same-origin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Supabase project values used only for Supabase Auth in the browser.
# Use the anon/publishable key from Supabase project settings, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key

# Optional canonical origin for email confirmation and password reset links.
# Set to https://moatcheck.onrender.com if requests made during local development
# should send users back to the deployed app. Leave unset to use the current origin.
NEXT_PUBLIC_SITE_URL=
